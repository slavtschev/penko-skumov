---
import Page from '../layouts/Page.astro';
import { inkLeft } from '../lib/ink';

/* D5-404 / D5-Phone-404: the title in the margin, the sentence and
   the two links on the axis. */

const TITLE = 'Page not found';
const SENTENCE = 'The page you are looking for doesn’t exist or has been moved';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
].map((l) => ({ ...l, ink: inkLeft(l.label, 'ui') }));

const titleInk = inkLeft(TITLE, 'display');
const titleInkXs = inkLeft(TITLE, 'displayXs');
const sentenceInk = inkLeft(SENTENCE, 'text');

---

<Page title={TITLE} footer={true} description={SENTENCE}>
  <div class="grid">
    <h1
      class="t-display ink-top span-4 start-1"
      style={`--ink-l: ${titleInk}px; --ink-l-xs: ${titleInkXs}px`}>
      {TITLE}
    </h1>

    {/* The sentence's cap-top sits on 64 too, level with the title's. The
        offset lives in the stylesheet, not inline, so the phone can
        override it -- an inline margin would win over the media query. */}
    <div class="aside span-4 start-5">
      <p class="t-text" style={`margin-left: -${sentenceInk}px`}>{SENTENCE}</p>
      <ul class="links t-ui">
        {
          links.map((l) => (
            <li>
              <a class="u" href={l.href} style={`margin-left: -${l.ink}px; --ul-l: ${l.ink}px`}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Page>

<style>
  h1 {
    white-space: nowrap;
    margin-left: calc(-1 * var(--ink-l));
  }

  @media (max-width: 767px) {
    h1 {
      margin-left: calc(-1 * var(--ink-l-xs));
    }
  }

  .aside {
    margin-top: calc(-1 * var(--cap-int-text));
  }

  .links {
    /* the sentence runs to 84 on the board, the first link's box to 146 */
    margin-top: 34px;
  }

  .links li + li {
    margin-top: 8px;
  }

  .links a {
    display: inline-block;
  }

  /* Phone: one column, the sentence under the title. */
  @media (max-width: 767px) {
    h1,
    .aside {
      grid-column: 1 / -1;
    }

    .aside {
      /* D5-Phone-404: the title's box ends at 96, the sentence's starts
         at 121 */
      margin-top: 25px;
    }

    .links {
      margin-top: 34px;
    }
  }
</style>
