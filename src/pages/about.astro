---
import { getEntry } from 'astro:content';
import Frame from '../components/Frame.astro';
import Page from '../layouts/Page.astro';
import { capGapAfterBaseline, capTop, descent, inkLeft } from '../lib/ink';
import { firstSentence } from '../lib/site';

/* D5-About. The Designs 5 axis: the portrait alone in the left margin,
   the title and the biography on column 5, the quotation across seven
   columns under them, and then three sections -- each an h2 Label on the
   margin and a list of year-and-entry rows on the axis.
   D5-Phone-About: one column in the same order, labels above lists. */

const aboutEntry = await getEntry('about', 'about');
const about = aboutEntry!.data;
const homeEntry = await getEntry('home', 'home');
const quotation = homeEntry!.data.quotation;

const TITLE = 'About';

/* No date ranges in the labels any more (Designs 5). */
const sections = [
  { label: 'Affiliations', rows: about.affiliations.map((a) => ({ year: a.years, html: a.html })) },
  { label: 'Exhibitions and awards', rows: [] as { year: string; html: string }[] },
  { label: 'Publications', rows: [] as { year: string; html: string }[] },
];

/* Each year group prints its year once, on its first entry. */
const rowsOf = (groups: { year: string; entries: string[] }[]) =>
  groups.flatMap((g) => g.entries.map((html, i) => ({ year: i === 0 ? g.year : '', html })));

sections[1].rows = rowsOf(about.exhibitions);
sections[2].rows = rowsOf(about.publications);

/*
  The vertical rules, all read off D5-About and D5-Phone-About:

  - the biography's last baseline stands on the foot of the portrait;
  - the quotation's cap-top sits 144 under the foot of the portrait
    caption's line box, and the first section's 144 under the
    quotation's last baseline;
  - every later section's cap-top sits 114 under the last baseline of
    the list above it (the handoff says 112; the board draws 114).

  The portrait caption is gone (Dimitar, 09.11) but the space it held is
  not: the quotation still starts where the board puts it. On the phone
  the title stands 61 under that same line instead, and the distances
  are the phone board's 98 and 52.
*/
const captionBlock = 8 + 16; // the caption's gap and its line box
const quoteGap = Math.ceil(captionBlock + 144 - capTop('quote'));
const titleGapXs = captionBlock + 61;
const bandGapFirst = capGapAfterBaseline('quote', 'ui', 144);
const bandGap = capGapAfterBaseline('ui', 'ui', 114);
const bandGapFirstXs = capGapAfterBaseline('text', 'label', 98);
const bandGapXs = capGapAfterBaseline('ui', 'label', 98);
---

<Page title={TITLE} current="about" description={firstSentence(about.bio[0] ?? null)}>
  <div class="grid head">
    <div class="portrait span-4 start-1">
      {
        about.portrait && (
          <Frame
            file={about.portrait.file}
            width={about.portrait.width}
            height={about.portrait.height}
            alt="Penko Skumov"
            span={4}
            priority={true}
          />
        )
      }
    </div>

    <div class="intro span-4 start-5">
      <h1
        class="t-display ink-top"
        style={`--ink-l: ${inkLeft(TITLE, 'display')}px; --ink-l-xs: ${inkLeft(TITLE, 'displayXs')}px`}>
        {TITLE}
      </h1>
      <div class="bio">
        {about.bio.map((p) => <p class="t-text">{p}</p>)}
      </div>
    </div>
  </div>

  <div class="grid">
    {/* seven columns, 785 at the L tier the boards are drawn on */}
    <blockquote class="quotation t-quote span-7 start-5">{quotation}</blockquote>
  </div>

  {
    sections.map((section) => (
      <section class="band grid">
        <h2 class="t-label label span-4 start-1" style={`margin-left: -${inkLeft(section.label, 'label')}px`}>
          {section.label}
        </h2>
        <dl class="pairs subgrid span-8 start-5">
          {section.rows.map((row) => (
            <div class="pair">
              <dt class="t-caption year">{row.year}</dt>
              <dd class="t-ui entry" set:html={row.html} />
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</Page>

<style
  define:vars={{
    quoteGap: `${quoteGap}px`,
    titleGapXs: `${titleGapXs}px`,
    bandGapFirst: `${bandGapFirst}px`,
    bandGap: `${bandGap}px`,
    bandGapFirstXs: `${bandGapFirstXs}px`,
    bandGapXs: `${bandGapXs}px`,
    textDescent: `${descent('text').toFixed(3)}px`,
  }}>
  .head {
    row-gap: 0;
  }

  h1 {
    white-space: nowrap;
    margin-left: calc(-1 * var(--ink-l));
  }

  /* The title stands on the portrait's top line and the biography's last
     baseline on its foot, so the column is read from both ends. */
  .intro {
    display: flex;
    flex-direction: column;
  }

  .bio {
    margin-top: auto;
    /* the last baseline on the foot of the portrait, not the line box */
    margin-bottom: calc(-1 * var(--textDescent));
    text-wrap: pretty;
  }

  .bio p + p {
    margin-top: var(--rhythm);
  }

  .quotation {
    display: block;
    margin: 0;
    margin-top: var(--quoteGap);
    text-wrap: pretty;
  }

  /* --- the three sections ---------------------------------------------- */
  .band {
    row-gap: 0;
    margin-top: var(--bandGap);
  }

  .band:first-of-type {
    margin-top: var(--bandGapFirst);
  }

  /* the label stays with its list for the length of it */
  .label {
    position: sticky;
    top: var(--header);
    align-self: start;
  }

  /* year in column 1 of the module, entry from column 2 on */
  .pairs {
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 12px;
    margin: 0;
  }

  .pair {
    display: contents;
  }

  .year {
    grid-column: 1;
    white-space: nowrap;
  }

  .entry {
    grid-column: 2 / -1;
    margin: 0;
    text-wrap: pretty;
  }

  /* links inside an entry are underlined outright, not on hover: they are
     inside running text, where a bare colour change would not show */
  .entry :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* --- the phone: one column, labels above lists ------------------------ */
  @media (max-width: 1023px) {
    .head > *,
    .band > *,
    .quotation {
      grid-column: 1 / -1;
    }

    .intro {
      display: block;
      margin-top: var(--titleGapXs);
    }

    .bio {
      margin-top: 24px;
      margin-bottom: 0;
    }

    /* 18/28 and grey on the phone, where 28/32 would not fit the measure */
    .quotation {
      font: 400 var(--text-size) / var(--text-line) var(--family);
      letter-spacing: 0;
      color: var(--grey);
      margin-top: 52px;
    }

    .band {
      margin-top: var(--bandGapXs);
    }

    .band:first-of-type {
      margin-top: var(--bandGapFirstXs);
    }

    .label {
      position: static;
      margin-bottom: 16px;
    }

    /* the year keeps its own column -- D5-Phone-About narrows it to 90,
       which is one column and one gutter at the XS tier, the same rule
       the page tier uses */
  }

  @media (max-width: 767px) {
    h1 {
      margin-left: calc(-1 * var(--ink-l-xs));
    }
  }
</style>
