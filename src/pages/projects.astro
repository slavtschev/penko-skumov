---
import { getCollection } from 'astro:content';
import Frame from '../components/Frame.astro';
import Page from '../layouts/Page.astro';
import { capGapAfterBaseline, capOffset, inkLeft, inkRight } from '../lib/ink';

/* D5-Projects. The Designs 5 axis: the page title alone on the left
   margin, one list on column 5 with the years in their own 115px column,
   and the preview of the series under the pointer in columns 9-12.
   Archive is a label on the margin with its list on the same axis.
   D5-Phone-Projects: one column, title over year, the label above its
   list. */

const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const frames = await getCollection('frames');

const withCover = series.map((entry) => {
  const cover = entry.data.cover ? frames.find((f) => f.id === entry.data.cover) : undefined;
  return {
    ...entry.data,
    href: `/projects/${entry.data.slug}/`,
    titleInk: inkLeft(entry.data.title, 'title'),
    titleInkRight: inkRight(entry.data.title, 'title'),
    yearInk: inkLeft(entry.data.years, 'caption'),
    cover: cover?.data,
    /* the caption reads "<place>, <years>"; place is still missing */
    captionText: [entry.data.place, entry.data.years].filter(Boolean).join(', '),
  };
});

const projects = withCover.filter((s) => s.group === 'projects');
const archive = withCover.filter((s) => s.group === 'archive');

const TITLE = 'Projects';
const ARCHIVE = 'Archive';

/* The Archive list begins 96 under the last project's baseline: the
   board's number (last row baseline 420.8, first archive cap-top 516.8),
   which follows no rule I could derive. */
const archiveGap = capGapAfterBaseline('title', 'title', 96);
/* the label's cap-top on the first title's */
const labelDrop = capOffset('title', 'label');

/* The phone is drawn, not derived: D5-Phone-Projects sets the first
   title 38 under the h1's line box, the year 5 under the title's, the
   rows 60 apart, the Archive label 76 under the last year and its list
   15 under the label. Taken from the board as they are. */
const XS = { listTop: 38, yearDrop: 5, pitch: 60, archiveGap: 76, labelToList: 15 };
const rowGapXs = XS.pitch - 32 - XS.yearDrop - 16;

const description =
  `${projects.length} projects and ${archive.length} from the archive, photographed by Penko Skumov.`;
---

<Page title={TITLE} current="projects" description={description}>
  <div class="index grid">
    <h1
      class="t-display ink-top span-4 start-1"
      style={`--ink-l: ${inkLeft(TITLE, 'display')}px; --ink-l-xs: ${inkLeft(TITLE, 'displayXs')}px`}>
      {TITLE}
    </h1>

    <ul class="rows ink-top subgrid t-title span-4 start-5">
      {
        projects.map((s) => (
          <li class="row" data-series={s.slug}>
            <span class="t-caption year" style={`margin-left: -${s.yearInk}px`}>
              {s.years}
            </span>
            {s.cover ? (
              <a
                class="u t-title title"
                href={s.href}
                style={`margin-left: -${s.titleInk}px; --ul-l: ${s.titleInk}px; --ul-r: ${s.titleInkRight}px`}>
                {s.title}
              </a>
            ) : (
              /* Film Archive is on the list but has no page and no frames
                 on the old site, so there is nothing to link to yet. */
              <span class="t-title title" style={`margin-left: -${s.titleInk}px`}>
                {s.title}
              </span>
            )}
          </li>
        ))
      }
    </ul>

    {/* One preview per series, stacked in the same slot; the pointer picks
        which is shown. They dissolve between each other over 300ms. */}
    <div class="previews span-4 start-9" aria-hidden="true">
      {
        withCover
          .filter((s) => s.cover)
          .map((s, i) => (
            <figure class="preview" data-preview={s.slug} data-first={i === 0 ? '' : undefined}>
              <div class={`plate plate-${s.cover!.width < s.cover!.height ? 2 : 4}`}>
                <Frame
                  file={s.cover!.file}
                  width={s.cover!.width}
                  height={s.cover!.height}
                  alt={null}
                  span={s.cover!.width < s.cover!.height ? 2 : 4}
                  spans={{ S: s.cover!.width < s.cover!.height ? 2 : 4 }}
                />
              </div>
              <figcaption class="t-caption caption">
                <span class="where">{s.captionText}</span>
                <span class="what">{s.title}</span>
              </figcaption>
            </figure>
          ))
      }
    </div>

    <h2
      class="t-label label span-4 start-1"
      style={`margin-left: -${inkLeft(ARCHIVE, 'label')}px; --label-drop: ${labelDrop}px`}>
      {ARCHIVE}
    </h2>

    <ul class="rows archive subgrid t-title span-4 start-5">
      {
        archive.map((s) => (
          <li class="row" data-series={s.slug}>
            <span class="t-caption year" style={`margin-left: -${s.yearInk}px`}>
              {s.years}
            </span>
            {s.cover ? (
              <a
                class="u t-title title"
                href={s.href}
                style={`margin-left: -${s.titleInk}px; --ul-l: ${s.titleInk}px; --ul-r: ${s.titleInkRight}px`}>
                {s.title}
              </a>
            ) : (
              <span class="t-title title" style={`margin-left: -${s.titleInk}px`}>
                {s.title}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style
  define:vars={{
    archiveGap: `${archiveGap}px`,
    listTopXs: `${XS.listTop}px`,
    yearDropXs: `${XS.yearDrop}px`,
    rowGapXs: `${rowGapXs}px`,
    archiveGapXs: `${XS.archiveGap}px`,
    labelToListXs: `${XS.labelToList}px`,
  }}>
  .index {
    position: relative;
    row-gap: 0;
    /* the title, the list and the preview share the first row; the
       Archive label and its list the second */
    grid-template-rows: auto auto;
  }

  /* base.css already clears the heading margins; setting them here would
     outrank .ink-top, which is what puts the cap-top on 64. */
  h1 {
    white-space: nowrap;
    grid-row: 1;
    align-self: start;
  }

  /* the Display style is the one that changes size with the tier, so its
     side bearing changes with it too */
  @media (max-width: 767px) {
    h1 {
      margin-left: calc(-1 * var(--ink-l-xs));
    }
  }

  @media (min-width: 768px) {
    h1 {
      margin-left: calc(-1 * var(--ink-l));
    }
  }

  /* --- the lists ------------------------------------------------------
     The year sits in its own 115px column (one column and one gutter at
     the L tier the boards are drawn on) and the title beside it, on the
     axis. Rows are 48 apart: a 32px line and 16 between. */
  /* The year sits in column 1 of the module and the title in column 2:
     115px apart at the L tier the boards are drawn on. A subgrid, so the
     columns are the page's own and not a share of the module's width. */
  .rows {
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    align-content: start;
    row-gap: 16px;
    grid-row: 1;
  }

  .rows.archive {
    grid-row: 2;
    margin-top: var(--archiveGap);
  }

  .row {
    display: contents;
  }

  .year {
    grid-column: 1;
    white-space: nowrap;
  }

  .title {
    grid-column: 2 / -1;
    justify-self: start;
    white-space: nowrap;
  }

  /* the label's cap-top on the cap-top of the first title it names */
  .label {
    grid-row: 2;
    align-self: start;
    margin-top: calc(var(--archiveGap) + var(--label-drop));
  }

  /* --- the preview slot ------------------------------------------------ */
  .previews {
    position: relative;
    grid-row: 1;
  }

  .preview {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    margin: 0;
    opacity: 0;
    transition: opacity var(--dissolve-out) var(--timing);
  }

  /* a landscape cover fills the slot; a portrait one takes two of its four
     columns, which is the 210px the board draws */
  .plate-4 {
    width: 100%;
  }

  .plate-2 {
    width: calc((100% - var(--gutter)) / 2);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: var(--caption-gap);
    white-space: nowrap;
  }

  .caption .what {
    color: var(--ink);
  }

  /* the first row shows by default, and gives way to whichever row the
     pointer is on */
  .index:not(:has(.row:hover)) .preview[data-first] {
    opacity: 1;
  }

  /* the first row of the Projects list only: it is the one whose preview
     is showing by default */
  .index:not(:has(.row:hover)) .rows:not(.archive) .row:first-child .title::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .preview {
      transition: none;
    }
  }

  /* The slot needs columns 9 to 12, so it exists only on the twelve-column
     tiers. */
  @media (max-width: 1023px) {
    .previews {
      display: none;
    }
  }

  /* XS: no room to hang anything in the margin, so the title stands above
     its list and the rows run title over year, 60 apart. */
  @media (max-width: 767px) {
    .index {
      display: block;
    }

    .rows {
      display: block;
      margin-top: var(--listTopXs);
    }

    .rows.archive {
      margin-top: 0;
    }

    .row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .row + .row {
      margin-top: var(--rowGapXs);
    }

    .title {
      order: -1;
    }

    .year {
      margin-top: var(--yearDropXs);
    }

    .label {
      margin-top: var(--archiveGapXs);
      margin-bottom: var(--labelToListXs);
    }
  }
</style>

<script>
  /* Show the preview for the row under the pointer. CSS alone would need a
     rule per series; this keeps the markup generated from the content. */
  const index = document.querySelector('.index');
  const previews = new Map<string, HTMLElement>();
  for (const el of document.querySelectorAll<HTMLElement>('.preview')) {
    const slug = el.dataset.preview;
    if (slug) previews.set(slug, el);
  }

  let shown: HTMLElement | undefined;

  const show = (slug: string | undefined) => {
    const next = slug ? previews.get(slug) : undefined;
    if (next === shown) return;
    if (shown) shown.style.opacity = '';
    shown = next;
    if (shown) shown.style.opacity = '1';
  };

  for (const row of document.querySelectorAll<HTMLElement>('.row')) {
    row.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch') return;
      show(row.dataset.series);
    });
  }

  index?.addEventListener('pointerleave', () => show(undefined));
</script>
