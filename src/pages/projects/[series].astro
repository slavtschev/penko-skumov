---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Frame from '../../components/Frame.astro';
import Page from '../../layouts/Page.astro';
import Speculate from '../../components/Speculate.astro';
import { boxTopForCap, capTop, descent, inkLeft, inkRight, styles } from '../../lib/ink';
import { firstSentence } from '../../lib/site';

/* D4-Series-Days and D4-Series-Vertical. Title, years, epigraph and
   statement across three modules, then bare frames -- no numbers, no
   captions -- on the page's own columns: four each for a landscape
   series, three each for a portrait one. The last cell is the way on. */

export const getStaticPaths = (async () => {
  const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
  const frames = await getCollection('frames');
  const withFrames = series.filter((s) => frames.some((f) => f.data.series === s.data.slug));

  return withFrames.map((entry, i) => ({
    params: { series: entry.data.slug },
    props: {
      series: entry.data,
      frames: frames
        .filter((f) => f.data.series === entry.data.slug)
        .sort((a, b) => a.data.order - b.data.order)
        .map((f) => f.data),
      /* the way on: the next series that has frames, wrapping round */
      next: withFrames[(i + 1) % withFrames.length].data,
    },
  }));
}) satisfies GetStaticPaths;

const { series, frames, next } = Astro.props;

/* A portrait series takes three columns a frame, a landscape one four. */
const portrait = frames[0].width < frames[0].height;
const span = portrait ? 3 : 4;
const perRow = portrait ? 4 : 3;

/* Designs 5: one text column on the axis, never two side by side. */
const paragraphs = series.statement ? series.statement.split('\n').filter(Boolean) : [];
const hasText = Boolean(series.epigraph || paragraphs.length);

/* An epigraph that opens with a quotation mark is set flush, as the boards
   do: you do not align a measure on a quote mark -- if anything it hangs
   outside. One that opens with a letter is ink-aligned like everything. */
const opensWithQuote = /^[“‘"']/.test(series.epigraph ?? '');
const epigraphInk = series.epigraph && !opensWithQuote ? inkLeft(series.epigraph, 'text') : 0;

/* The years' cap-top sits 64 under the title's on the page and 46 on the
   phone -- D5-Series-Days and D5-Phone-Series; the distance follows no
   rule I could derive, so it is the boards'. As a margin under the
   title's line box, which is where the years fall in the flow. */
const yearsGap = (tier: 'L' | 'XS') => {
  const face = tier === 'L' ? 'display' : 'displayXs';
  const titleBottom = 64 - Math.floor(capTop(face)) + styles[face].line;
  return boxTopForCap('caption', 64 + (tier === 'L' ? 64 : 46)) - titleBottom;
};

/* The frames begin 80 under the last baseline of the text on the page and
   52 under it on the phone (D5-Series-Days, D5-Phone-Series). Measured to
   the box, and floored, because a frame sits on a whole pixel. */
const framesGap = Math.floor(80 - descent('text'));
const framesGapXs = 52;
/* with no text at all they follow the years (D5-Series-Vertical: 216) */
const framesGapBare = Math.floor(80 - descent('caption'));

const titleInk = inkLeft(series.title, 'display');
const titleInkXs = inkLeft(series.title, 'displayXs');
const NEXT = 'Next';
const nextInk = { l: inkLeft(next.title, 'title'), r: inkRight(next.title, 'title') };
/* the opening of the statement, or the plain facts where there is none */
const description =
  firstSentence(series.statement) ??
  `${series.title}, ${series.years}. Photographs by Penko Skumov.`;

const BACK = 'Back to Projects';
const backInk = inkLeft(BACK, 'caption');
---

<Page title={series.title} current="projects" description={description}>
  <div class="grid head">
    <div class="name span-4 start-1">
      <h1
        class="t-display ink-top"
        style={`--ink-l: ${titleInk}px; --ink-l-xs: ${titleInkXs}px`}>
        {series.title}
      </h1>
      <p class="t-caption years" style={`margin-left: -${inkLeft(series.years, 'caption')}px`}>
        {series.years}
      </p>
    </div>

    {
      hasText && (
        <div class="text ink-top span-4 start-5">
          {series.epigraph && (
            <p class="t-text epigraph" style={`margin-left: -${epigraphInk}px`}>
              {series.epigraph}
            </p>
          )}
          {series.epigraphSource && (
            <p
              class="t-caption attribution"
              style={`margin-left: -${inkLeft(series.epigraphSource, 'caption')}px`}>
              {series.epigraphSource}
            </p>
          )}
          {paragraphs.length > 0 && (
            <div class="statement">
              {paragraphs.map((text) => (
                <p class="t-text">{text}</p>
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>

  <div class="grid frames" style={`--series-ratio: ${+(frames[0].width / frames[0].height).toFixed(6)}`}>
    {
      frames.map((frame, i) => (
        <a
          class:list={['cell', `span-${span}`]}
          href={`/projects/${series.slug}/${frame.order}/`}
          data-astro-prefetch
          aria-label={`Photograph ${frame.order} of ${frames.length}`}
          style={`--i: ${i % perRow}`}>
          <Frame
            file={frame.file}
            width={frame.width}
            height={frame.height}
            alt={frame.alt}
            span={span}
            column={i % perRow}
            priority={i < perRow}
          />
        </a>
      ))
    }

    <div class:list={['wayon', `span-${span}`]}>
      <div class="wayon-box">
      <p class="t-label ink-top next-label" style={`margin-left: -${inkLeft(NEXT, 'label')}px`}>
        {NEXT}
      </p>
      <a
        class="u t-title next-title"
        href={`/projects/${next.slug}/`}
        style={`margin-left: -${nextInk.l}px; --ul-l: ${nextInk.l}px; --ul-r: ${nextInk.r}px`}>
        {next.title}
      </a>
      <p class="t-caption next-years" style={`margin-left: -${inkLeft(next.years, 'caption')}px`}>
        {next.years}
      </p>
      <a
        class="u t-caption back"
        href="/projects/"
        style={`margin-left: -${backInk}px; --ul-l: ${backInk}px`}>{BACK}</a
      >
      </div>
    </div>
  </div>

  <Speculate match="/projects/*" />
</Page>

<style
  define:vars={{
    yearsGap: `${yearsGap('L')}px`,
    yearsGapXs: `${yearsGap('XS')}px`,
    framesGap: `${framesGap}px`,
    framesGapXs: `${framesGapXs}px`,
    framesGapBare: `${framesGapBare}px`,
    titleInk: `${titleInk}px`,
    titleInkXs: `${titleInkXs}px`,
  }}>
  .head {
    row-gap: 0;
  }

  /* --- the left margin: the title and the years, and nothing else ----- */
  h1 {
    white-space: nowrap;
    margin-left: calc(-1 * var(--titleInk));
  }

  .years {
    margin-top: var(--yearsGap);
  }

  /* --- the text, one column on the axis ------------------------------
     The epigraph's first line stands on the title's cap-top; its source
     follows one rhythm under its last baseline and the statement two
     under that. The boards set 9 and 31 between the boxes, which is
     those two rules to within a pixel. */
  .text {
    --ink-cap-int: var(--cap-int-text);
    text-wrap: pretty;
  }

  .epigraph {
    color: var(--grey);
  }

  .attribution {
    margin-top: 9px;
  }

  .statement {
    margin-top: 31px;
  }

  .statement p + p {
    margin-top: var(--rhythm);
  }

  /* --- the frames ------------------------------------------------------ */
  .frames {
    row-gap: 20px;
    margin-top: var(--framesGap);
  }

  /* a series with no text at all follows the years instead */
  .head:not(:has(.text)) + .frames {
    margin-top: var(--framesGapBare);
  }

  .cell {
    display: block;
  }

  /* --- the way on ------------------------------------------------------ */
  /* the title's box one rhythm under the label's, as D5-Series-Days
     draws it (2443 and 2471) */
  .next-title {
    display: block;
    margin-top: calc(var(--rhythm) - var(--name-line));
    white-space: nowrap;
  }

  .next-years {
    margin-top: 10px;
  }

  /* The way on is a cell like any other: it keeps a frame's proportions
     so that "Back to Projects" sits on the bottom edge of the row. Where
     the frames fill their rows exactly it would otherwise be only as tall
     as its own three lines, and the link landed on the years above it and
     the footer below. */
  .wayon {
    container-type: inline-size;
  }

  /* The box is as tall as a frame of this series in this module: the
     photograph's proportion snapped DOWN to a whole pixel, the same
     derivation Frame makes, so the row and the link on its bottom edge
     stay on integer pixels. (An aspect-ratio on the cell leaves both on
     a fraction; a container query unit cannot resolve against the
     element that declares the container, hence the inner box.) */
  .wayon-box {
    position: relative;
    /* flow-root, so the first line's negative ink offset does not
       collapse through and carry the box 4px up the row. */
    display: flow-root;
    height: round(down, calc(100cqw / var(--series-ratio)), 1px);
  }

  /* on the cell's bottom edge */
  .back {
    position: absolute;
    bottom: -5px;
    left: 0;
  }

  /* The link hangs 5px below the grid, so the grid's own box ends above
     its last line. Without this the line lands on the footer. 28 is the
     body rhythm: 11 of it is the overhang, 17 the gap to the footer. */
  @media (min-width: 1024px) {
    .frames {
      padding-bottom: var(--rhythm);
    }
  }

  /* Phone: one column, the text under the title and the years, labels
     above what they name. */
  @media (max-width: 1023px) {
    .head > * {
      grid-column: 1 / -1;
    }

    .text {
      margin-top: 27px;
    }
  }

  @media (max-width: 767px) {
    h1 {
      margin-left: calc(-1 * var(--titleInkXs));
    }

    .years {
      margin-top: var(--yearsGapXs);
    }

    /* D5-Phone-Series sets 27 between the source and the statement where
       the page sets 31 */
    .statement {
      margin-top: 27px;
    }

    .frames {
      row-gap: 12px;
      /* D5-Phone-Series sets the frames 52 under the text */
      margin-top: var(--framesGapXs);
    }

    .cell {
      grid-column: 1 / -1;
    }

    .wayon {
      grid-column: 1 / -1;
      margin-top: 64px;
    }

    /* On one column the way on is three lines and a link, not a cell in
       a row of frames: it takes its own height. */
    .wayon-box {
      height: auto;
    }

    .back {
      position: static;
      display: block;
      margin-top: 24px;
    }
  }
</style>

<script>
  /* Opening a photograph shows it over this page rather than leaving it;
     the frame's own page is still what the overlay is made of, and still
     what a direct link, a shared link or a reader without JavaScript
     gets. */
  import { mountViewerOverlay } from '../../lib/viewer-overlay';

  mountViewerOverlay(window.location.pathname);
</script>
